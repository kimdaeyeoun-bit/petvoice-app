{
  "name": "lumina-ai-cinema",
  "version": "1.0.0",
  "private": true,
  "description": "AI cinema and festival platform",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check server.mjs && node --check public/app.js",
    "test:browser": "node test/browser.cjs",
    "preview:build": "node scripts/build-preview.mjs",
    "test:preview": "node test/preview.cjs",
    "release:build": "npm run preview:build && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0"
  }
}
